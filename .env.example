# Supabase — new-style keys (sb_publishable_ / sb_secret_)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Database — Pooler URL for Vercel runtime (Hardening Rule #1: Supavisor Transaction Mode)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Database — Direct URL for migrations only (NEVER use in production runtime)
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Public site URL — single source of truth for absolute URLs in client/server code.
# Used for email copy, OAuth/recovery callback construction, and any place we need
# to render a link back to the app. Set to the deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
