# =============================================================================
# LawPass — single consolidated env template.
# Copy to `.env.local` (gitignored) and fill in. This ONE file is read by
# BOTH servers: the Next.js app (auto-loads .env.local from this dir) and the
# Express server (lawpass_server/config/env.js resolves ../.env.local).
# Do not create a separate lawpass_server/.env — it would split the config.
# =============================================================================

# Supabase — new-style keys (sb_publishable_ / sb_secret_) — shared by both
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Database — Pooler URL for Vercel runtime (Hardening Rule #1: Supavisor Transaction Mode)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Database — Direct URL for migrations only (NEVER use in production runtime)
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Public site URL — single source of truth for absolute URLs in client/server code.
# Used for email copy, OAuth/recovery callback construction, and any place we need
# to render a link back to the app. Set to the deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Express server (lawpass_server) ---
# The server reads these from THIS same file (../.env.local).
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed to call the API (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000

# --- Frontend → server wiring ---
# When set, the Next.js client calls the Express API instead of the in-app
# server actions. LOCAL DEV: http://localhost:4000. On Vercel/production
# leave this UNSET until the Express server is deployed — the frontend then
# falls back to the built-in server actions, so production is unaffected.
NEXT_PUBLIC_API_BASE_URL=

# --- Cloudinary (handwritten answer photos) ---
# Read by the Express server ONLY — the API secret must never reach the browser,
# so none of these are NEXT_PUBLIC_. Values come from the Cloudinary dashboard:
#   Settings → API Keys  (cloud name is in the same panel, "Product Environment")
# Leave blank and everything else still works; only the handwriting upload
# answers with "העלאת תמונות אינה מוגדרת בשרת".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder uploads are filed under; per-user/per-question subfolders hang off
# it. Optional — this is the default.
CLOUDINARY_FOLDER=lawpass/handwriting

# --- Resend (transactional email) ---
# Read by lib/email. Server-side only — the API key must never reach the
# browser, so none of these are NEXT_PUBLIC_. Verify with:
#   npm run email:check
#   npm run email:check -- you@example.com
#
# The API key. Resend dashboard → API Keys → Create API Key, permission
# "Sending access". Starts with "re_". Shown once — copy it immediately.
RESEND_API_KEY=
#
# The sender. MUST be on a domain verified in Resend (dashboard → Domains),
# otherwise every send fails with a 422. Format is "Name <address>".
#   production:  LawPass <noreply@your-verified-domain>
#   testing:     LawPass <onboarding@resend.dev>   — works with no domain setup,
#                but can ONLY deliver to your own Resend account address.
RESEND_FROM_EMAIL=
#
# Where replies go. Optional — without it, a candidate replying to a
# notification writes to the unattended noreply mailbox and nobody reads it.
RESEND_REPLY_TO=
#
# Set to 1 to compose and log emails without sending any. Useful while
# building a new template. Opt-in only: it is never enabled automatically,
# because a dry run that switched itself on would silently eat real mail.
EMAIL_DRY_RUN=

# --- Writing tasks: marking allowance (lawpass_server) ---
# How many COMPLETED markings one student may have on one writing task
# (מטלת כתיבה). Each marking is a model call we pay for, and nothing else
# limits how many times the same task can be submitted.
#
# Only a grading that actually wrote a score counts. A marking that fails
# (model timeout, provider outage) does NOT consume the allowance, so "בדוק
# שוב" stays free and a student is never left with a used quota and no
# feedback.
#
# Optional — 1 is the default if unset or blank. Must be a whole number of at
# least 1; anything else is ignored with a warning in the log. Changing it
# needs only a server restart, no migration.
#
# The spent counts live in public.open_question_grades_counts.
OPEN_QUESTION_MAX_GRADES=1

# --- SMS campaigns (lawpass_server/lib/sms) ---
# Read by the Express server ONLY, and only by the campaign script — the API
# has no SMS endpoint. Nothing here is NEXT_PUBLIC_: the key/user/password are
# the account itself, and anything in the bundle is public.
#
# Which gateway to use. "mock" (the default when unset) prints the message and
# sends nothing, so a half-configured environment cannot message a real list.
# Set to "sms4free" only when you actually want messages to go out.
SMS_PROVIDER=mock
#
# SMS4Free credentials — https://www.sms4free.co.il → the account dashboard.
SMS4FREE_KEY=
SMS4FREE_USER=
SMS4FREE_PASSWORD=
#
# Fallback sender name. The campaign's own sender lives in
# lawpass_server/lib/sms/campaign.json ("sender": "LawPass"), next to the
# message text; this is only for overriding it per environment.
#
# NOTE: a sender made of LETTERS ("LawPass") requires a PAID package and, in
# Israel, pre-registration of the name with the carriers — it is not something
# that works the moment you buy credit. Until it is approved, SMS4Free only
# accepts the phone number the account was registered with as the sender, and
# rejects anything else with error -2. That is why the message body opens with
# "LawPass" as its first word: the recipient knows who it is from either way.
SMS_SENDER=LawPass

# --- Re-engagement cron (/api/cron/reengagement) ---
# Vercel Cron calls the endpoint with "Authorization: Bearer $CRON_SECRET".
# Generate any long random string. WITHOUT THIS THE ENDPOINT REFUSES EVERY
# REQUEST — it is closed by default, because it sends real email.
CRON_SECRET=
#
# Signs the one-click unsubscribe links so they cannot be forged for another
# user. Any long random string; falls back to SUPABASE_SECRET_KEY if unset,
# but set it separately so rotating one does not break the other.
EMAIL_UNSUBSCRIBE_SECRET=
#
# Tuning. All four are optional — the defaults shown are what the code uses if
# they are unset or blank. Anything that is not a positive whole number is
# ignored with a warning in the log, so a typo cannot break the job.
#
# How long a candidate must be silent (no login, no exam, no practice, no
# answer of any kind) before a nudge is due. 24 is aggressive for someone who
# studies every other day; 72 is a gentler starting point.
REENGAGEMENT_INACTIVE_HOURS=24
# Minimum gap between two nudges to the SAME person. 168 = 7 days.
REENGAGEMENT_COOLDOWN_HOURS=168
# How many nudges one person will ever get before we stop asking.
REENGAGEMENT_MAX_NUDGES=3
# Emails per run. The cron is hourly, so a backlog drains over the day.
REENGAGEMENT_BATCH_LIMIT=25
