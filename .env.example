# =============================================================================
# LawPass — single consolidated env template.
# Copy to `.env.local` (gitignored) and fill in. This ONE file is read by
# BOTH servers: the Next.js app (auto-loads .env.local from this dir) and the
# Express server (lawpass_server/config/env.js resolves ../.env.local).
# Do not create a separate lawpass_server/.env — it would split the config.
# =============================================================================

# Supabase — new-style keys (sb_publishable_ / sb_secret_) — shared by both
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Database — Pooler URL for Vercel runtime (Hardening Rule #1: Supavisor Transaction Mode)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Database — Direct URL for migrations only (NEVER use in production runtime)
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Public site URL — single source of truth for absolute URLs in client/server code.
# Used for email copy, OAuth/recovery callback construction, and any place we need
# to render a link back to the app. Set to the deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Express server (lawpass_server) ---
# The server reads these from THIS same file (../.env.local).
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed to call the API (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000

# --- Frontend → server wiring ---
# When set, the Next.js client calls the Express API instead of the in-app
# server actions. LOCAL DEV: http://localhost:4000. On Vercel/production
# leave this UNSET until the Express server is deployed — the frontend then
# falls back to the built-in server actions, so production is unaffected.
NEXT_PUBLIC_API_BASE_URL=
