# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local
.env.development
.env.production
!.env.example

# supabase local config
supabase/.temp/

# ingestion pipeline working dir — downloaded .docx, parsed JSON, generated SQL.
# Scripts under scripts/ingestion/ are committed; the per-batch artifacts under
# scripts/ingestion/tmp/ are local-only.
scripts/ingestion/tmp/

# diuni Batch API manifests — what one submitted job sent, so --resume can
# collect it later. The generated drafts beside them ARE committed; these are
# not: each embeds the full text of every judgment in the batch, which is
# megabytes, already in verdict_list, and useless once the batch is collected.
scripts/diuni/generated/.batches/

# open-question Batch API run dirs — the per-stage request envelopes and the
# state.json that --resume reads. Same reasoning: each envelope carries the full
# prompt (source text and quote bank) for one call, they are large, and they are
# worthless once the run is collected. The generated sets beside them ARE committed.
scripts/ingestion/open_questions/generated/.batches/

# python bytecode cache (from running scripts/ingestion/*.py)
__pycache__/

# vercel
.vercel

# claude code — personal settings for this checkout (model choice etc).
# The rest of .claude/ IS committed: skills/, agents/ and launch.json are
# project knowledge the next person needs.
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma
